-        if marginals:
-            belief_marginals = dict(marginals)
-
-            # Compute accuracy: for each agent in marginals, check if
-            # the inferred classification matches ground truth
-            hidden_threshold = getattr(belief_inference, '_hidden_threshold', 0.6)
-            correct = 0
-            total = 0
